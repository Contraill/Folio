{
  // The Worker connected to Workers Builds. Pushes to main deploy it to production,
  // pushes to any other branch only create a Preview. See docs/deployment.md.
  "name": "folio",
  "compatibility_date": "2026-10-31",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Production is reached through its custom domain only. Preview hostnames are a separate setting.
  "workers_dev": false,
  "preview_urls": true,
  // Previews do not inherit production settings. Storage added at the top level must be
  // repeated here pointing at Preview-only resources, so a Preview can never reach production data.
  "previews": {
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "redact_query_string": true,
      "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
      "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
      "issues": { "enabled": true }
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
