{
  // The site is static: Cloudflare serves dist/ as built, with headers from public/_headers and no code of its own.
  // Deploys come only from GitHub Actions (docs/deployment.md); the custom domain oztozlu.dev is set on the Worker.
  "name": "folio",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    // An unknown address gets the nearest 404.html: under /tr the Turkish page, anywhere else the English one.
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": true,
  // `wrangler preview` (the Preview of develop) requires this block; the Preview uses the settings above as they are.
  "previews": {}
}
