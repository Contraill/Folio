{
  // Not "folio": that is the production Worker serving the coming-soon page.
  // Workers Builds fails when this name differs from the connected Worker, so a
  // merge to main cannot replace production by accident. See docs/deployment.md.
  "name": "folio-dev",
  "compatibility_date": "2026-10-31",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Only custom domains may reach the app, so Access can never be bypassed through these.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    },
    "issues": {
      "enabled": true
    }
  }
}
