---
/* Temporary: keeps the navigation working while the remaining pages migrate. Each page removes
   its entry here when it moves over, and this file goes away with the last one. */
import { BY_ID } from '@/content/projects';
import { messages } from '@/i18n/messages';
import Base from '@/layouts/Base.astro';

const path = Astro.params.stub ?? '';
const t = messages[Astro.locals.locale];
const labels: Record<string, string> = { '': t.nav.home, projects: t.nav.projects, lab: t.nav.lab, play: t.nav.play, about: t.nav.about, uses: 'Uses', now: 'Now', secret: 'Secret' };
const project = path.startsWith('projects/') ? BY_ID[path.slice('projects/'.length)] : undefined;
const label = project?.name ?? labels[path];
if (!label) return new Response(null, { status: 404 });
---
<Base title={path ? label : undefined} noindex>
  <section class="slab pad" aria-labelledby="stub-h" style="min-height: 60vh">
    <p class="eyebrow" data-reveal>{label}</p>
    <h1 id="stub-h" class="display stair" style="font-size: clamp(42px, 5.6vw, 88px); margin-top: 18px" data-reveal="fade">{label}</h1>
    <p class="small" style="margin-top: 22px; max-width: 44ch" data-reveal>{t.migrating}</p>
  </section>
</Base>
