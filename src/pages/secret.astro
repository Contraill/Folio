---
import { ArrowRight } from 'lucide-react';
import Letters from '@/components/Letters';
import { getContent } from '@/content/request';
import Base from '@/layouts/Base.astro';

const c = (await getContent(Astro.locals)).pages.secret;
---
<Base title={c.title} noindex>
  <section class="slab pad" aria-labelledby="s-h">
    <p class="eyebrow">/secret</p>
    <h1 id="s-h" class="display" style="font-size: clamp(36px, 4vw, 56px); margin-top: 16px">{c.h1}</h1>
    <p class="small" style="margin-top: 12px; max-width: 50ch">{c.note}</p>
    <Letters client:load label={c.letter} />
    <a class="btn btn-1" href="/play">{c.open}<span class="ic"><ArrowRight size={16} aria-hidden="true" /></span></a>
  </section>
</Base>
