---
import AppCatalog from '@/components/AppCatalog.astro';
import LabStage from '@/components/LabStage';
import { getContent } from '@/content/load';
import Base from '@/layouts/Base.astro';
import { localePaths } from '@/lib/locales';

export const getStaticPaths = localePaths;

const { pages, apps } = await getContent(Astro.locals);
const experiments = apps.filter((a) => a.kind === 'lab');
const c = pages.lab;
---
<Base title={c.title}>
  <div class="lab">
    <LabStage client:load c={c} />
    <AppCatalog kind="lab" apps={experiments} heading={c.catalogH} note={c.catalogNote} empty={c.empty} locale={Astro.locals.locale} />
  </div>
</Base>
