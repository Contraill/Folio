---
import Cover from '@/components/Cover';
import Unlock from '@/components/Unlock';
import { getContent } from '@/content/load';
import { messages } from '@/i18n/messages';
import Base from '@/layouts/Base.astro';
import { localePaths } from '@/lib/locales';

export const getStaticPaths = localePaths;

/* What changed last, from the GitHub data of this build: the latest commit on the default branch of each public
   repository. Only public repositories are in the data at all, so nothing private can show here. Finding this page
   also unlocks the Terminal skin. */
const locale = Astro.locals.locale;
const { pages: content, projects, activity, fetchedAt } = await getContent(Astro.locals);
const c = content.now;
const when = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });
const latest = projects.find((p) => p.id === activity[0]?.project);
---
<Base title={c.title} noindex={c.visibility === 'unlisted'}>
  <section class="nowp" aria-labelledby="n-h">
    <div class="slab img" style="overflow: hidden">{latest && <Cover p={latest} variant="hero" eager c={content.stage} altSuffix={content.case.screenshot} />}</div>
    <div class="slab pad dark">
      <div>
        <p class="eyebrow">{c.eyebrow}</p>
        <h1 id="n-h" class="display" style="font-size: clamp(44px, 5vw, 80px); margin-top: 16px">{c.h1}</h1>
        <p class="now-lede">{c.lede}</p>
      </div>
      <div>
        <p class="eyebrow plain" style="margin-bottom: 6px">{c.commits}</p>
        {activity.length === 0 ? <p class="small">{c.empty}</p> : (
          <ul class="pushes">
            {activity.map((a) => (
              <li>
                <span class="push-what">{a.project ? <a class="link-u" href={`/projects/${a.project}`} translate="no">{a.repo}</a> : <span translate="no">{a.repo}</span>}<a class="push-msg" href={a.url} target="_blank" rel="noreferrer">{a.message}</a></span>
                <time class="tnum" datetime={a.date}>{when.format(new Date(a.date))}</time>
              </li>
            ))}
          </ul>
        )}
        <p class="small" style="margin-top: 14px"><time datetime={fetchedAt}>{c.synced.replace('{t}', when.format(new Date(fetchedAt)))}</time></p>
      </div>
    </div>
  </section>
  <Unlock client:load skin="terminal" message={messages[locale].unlocked.terminal} />
</Base>
