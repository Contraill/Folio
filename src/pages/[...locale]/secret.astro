---
import { ArrowRight } from 'lucide-react';
import Letters from '@/components/Letters';
import Unlock from '@/components/Unlock';
import { messages } from '@/i18n/messages';
import { getContent } from '@/content/load';
import Base from '@/layouts/Base.astro';
import { localePaths } from '@/lib/locales';

export const getStaticPaths = localePaths;

const c = (await getContent(Astro.locals)).pages.secret;
---
<Base title={c.title} noindex={c.visibility === 'unlisted'}>
  <section class="slab pad" aria-labelledby="s-h">
    <p class="eyebrow">/secret</p>
    <h1 id="s-h" class="display" style="font-size: clamp(36px, 4vw, 56px); margin-top: 16px">{c.h1}</h1>
    <p class="small" style="margin-top: 12px; max-width: 50ch">{c.note}</p>
    <Letters client:load word={c.word} label={c.letter} />
    <a class="btn btn-1" href="/play">{c.open}<span class="ic"><ArrowRight size={16} aria-hidden="true" /></span></a>
  </section>
  <Unlock client:load skin="blueprint" message={messages[Astro.locals.locale].unlocked.blueprint} />
</Base>
