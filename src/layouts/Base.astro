---
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/Footer.astro';
import Toasts from '@/components/Toasts';
import Topbar from '@/components/Topbar';
import { messages } from '@/i18n/messages';
import { PREPAINT } from '@/lib/prepaint';
import '@/styles/reset.css';
import '@/styles/fonts.css';
import '@/styles/tokens.css';
import '@/styles/site.css';
import '@/styles/motion.css';
import '@/styles/pages.css';
import '@/styles/ui.css';
import '@/styles/adaptations.css';

interface Props {
  title?: string;
  description?: string;
  /** Unlisted and error pages stay out of search engines. */
  noindex?: boolean;
  /** Repository of the project on this page, for the top bar's link. */
  repo?: string;
}

const locale = Astro.locals.locale;
const t = messages[locale];
const { title, description = t.description, noindex = false, repo } = Astro.props;
const fullTitle = title ? `${title} · İzzet Can` : t.title;

// One clean address per page, the same in both languages: the language Worker picks the version per visitor.
const canonical = new URL(Astro.locals.path, Astro.site);

const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(PREPAINT));
Astro.csp?.insertScriptHash(`sha256-${btoa(String.fromCharCode(...new Uint8Array(digest)))}`);
---
<!doctype html>
<html lang={locale} data-skin="graphite">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f0f10" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="İzzet Can Öztozlu" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icons/graphite.svg" type="image/svg+xml" data-skin-icon />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="İzzet Can Öztozlu" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <script is:inline set:html={PREPAINT}></script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="frame" id="top">
      <Topbar client:load transition:persist="topbar" transition:persist-props t={t} path={Astro.locals.path} repo={repo} locale={locale} />
      <main id="main" tabindex="-1" data-repo={repo}><slot /></main>
      <Footer />
    </div>
    <div id="overlays" transition:persist="overlays"><Toasts client:idle /></div>
    <script>
      import '@/lib/shell';
    </script>
  </body>
</html>
