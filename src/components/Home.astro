---
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import Icon from './Icon.astro';
import Mochi from './Mochi.astro';
import { about, also, caseOrder, cv, EMAIL, featured, fetch, GITHUB, LINKEDIN, localePath, term, ui, type Locale } from '../data';
import { loadProjects } from '../lib/projects';
import { homeSchema } from '../lib/schema';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale], c = cv[locale], a = about[locale], f = fetch[locale];
const ICON: Record<string, string> = {
  code: 'M8 7l-5 5 5 5M16 7l5 5-5 5', window: 'M3 5h18v14H3zM3 9h18', db: 'M4 6c0 1.7 3.6 3 8 3s8-1.3 8-3-3.6-3-8-3-8 1.3-8 3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  flask: 'M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3', gear: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1',
  server: 'M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01', globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18', clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2',
};
let row = 0;
const projects = await loadProjects(locale);
const get = (id: string) => {
  const p = projects.get(id);
  if (!p) throw new Error(`No project "${id}" in src/content/projects`);
  return p;
};
// Split on commas outside parentheses, so "Linux (Arch, Debian)" stays one item, then drop the parenthesis.
const stack = [...new Set(c.skills.flatMap(([, v]) => v.split(/,\s*(?![^()]*\))/).map((s) => s.replace(/ \(.*\)$/, ''))))];
const timeline = [
  { when: c.job.when, title: c.job.role, org: `${c.job.company}, ${c.job.where}`, items: c.duties, extras: undefined, link: { href: localePath(locale, `/projects/${c.job.project}`), label: c.job.projectLabel } },
  { when: c.school.when, title: c.school.degree, org: `${c.school.name}, ${c.school.where}`, items: c.schoolNotes, extras: c.extras, link: undefined },
];
const k = term[locale];
// Everything the hero's terminal prints, handed to scripts/terminal.ts.
const termData = {
  name: 'İzzet Can Öztozlu', email: EMAIL, linkedin: LINKEDIN, github: GITHUB, cv: localePath(locale, '/cv'),
  otherHref: localePath(locale === 'en' ? 'tr' : 'en', '/'),
  projects: caseOrder.map((id) => {
    const p = get(id);
    const note = featured.find((f) => f.id === id)?.kicker[locale] ?? p.lang;
    return { id, name: p.name, note, href: p.case ? localePath(locale, `/projects/${id}`) : `https://github.com/Contraill/${p.repo}`, external: !p.case };
  }),
  // git log: the projects and the CV's milestones, newest first, each with a short hash made from its name.
  log: [
    ...['orbis', 'mochi', 'nodesk', 'nothing', 'helios', 'campuseats', 'huepr', 'bct'].map((id) => ({ id, when: get(id).since, msg: `feat: ${get(id).name}` })),
    { id: 'internship', when: `${c.job.when.split(' – ')[0]} ${c.job.when.match(/\d{4}/)?.[0] ?? ''}`, msg: `work: ${c.job.role}, ${c.job.company}` },
    { id: 'university', when: c.school.when.split(' – ')[0], msg: `init: ${c.school.degree}` },
  ].map(({ id, when, msg }) => ({ hash: [...id].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 7).toString(16).padStart(7, '0').slice(0, 7), when, msg })),
  s: { ...k, role: t.lede },
};
let n = 0;
/** The name's words, letter by letter, so the letters can rise one after another while each word stays whole. */
const words = (line: string) => line.split(' ').map((word) => [...word].map((ch) => ({ ch, i: n++ })));
---
<Base locale={locale} path="/" schema={homeSchema(locale)}>
  <section class="hero" aria-labelledby="name">
    <canvas class="sky" aria-hidden="true"></canvas>
    <div class="hero-text">
      <h1 id="name" class="name">
        <span class="sr">İzzet Can Öztozlu</span>
        {['İzzet Can', 'Öztozlu'].map((line) => <span class="line" aria-hidden="true">{words(line).map((word) => <span class="word">{word.map(({ ch, i }) => <span class="ch" style={`--i: ${i}`}>{ch}</span>)}</span>)}</span>)}
      </h1>
      <div class="prompt">
        <p class="segments" aria-hidden="true"><span class="seg-dir"><svg viewBox="0 0 24 24"><path d="M3 6h7l2 2h9v11H3z" /></svg>~/oztozlu.dev</span><span class="seg-git"><svg viewBox="0 0 24 24"><path d="M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9a9 9 0 0 1-9 9" /></svg>main</span></p>
        <p class="role"><span class="chevron" aria-hidden="true">❯</span> <span class="typed" style={`--n: ${t.role.length}`}>{t.role}</span></p>
      </div>
      <p class="lede">{t.lede}</p>
      <div class="actions">
        <a class="btn btn-1" href={`/cv/${locale}.pdf`} download={`Izzet-Can-Oztozlu-CV-${locale.toUpperCase()}.pdf`}><span>{t.downloadCv}</span> <Icon name="down" /></a>
        <a class="btn btn-2" href={localePath(locale, '/cv')} data-cv-link><span>{t.viewCv}</span></a>
        <a class="btn btn-2" href={`mailto:${EMAIL}`}><span>{t.emailMe}</span> <Icon name="mail" /></a>
        <a class="circle" href={GITHUB} target="_blank" rel="noreferrer" aria-label="GitHub"><Icon name="github" /></a>
        <a class="circle" href={LINKEDIN} target="_blank" rel="noreferrer" aria-label="LinkedIn"><Icon name="linkedin" /></a>
      </div>
    </div>
    <div class="stage">
      <figure class="pet">
        <Mochi label={t.mochi} big />
        <figcaption>{t.mochiCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section id="work" class="slab pad" aria-labelledby="work-h" data-spy="work">
    <div class="shead" data-reveal>
      <h2 id="work-h" class="title">{t.work}</h2>
      <p>{t.workNote}</p>
    </div>
    <div class="deck">
      {featured.map((f, i) => (
        <div class="deck-item" style={`--i: ${i}`}>
          <Card p={get(f.id)} locale={locale} kicker={f.kicker[locale]} stack={f.stack} point={f.point[locale]} wide />
        </div>
      ))}
    </div>
    <h3 class="sub" data-reveal>{t.also}</h3>
    <div class="grid-3">
      {also.map((id, i) => <div data-reveal style={`--d: ${i}`}><Card p={get(id)} locale={locale} small /></div>)}
    </div>
    <a class="text-link" href={GITHUB} target="_blank" rel="noreferrer" data-reveal>{t.allRepos} <Icon name="out" /></a>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">{[0, 1].map(() => <span>{stack.map((s) => <b>{s}</b>)}</span>)}</div>
  </div>

  <section id="experience" class="slab pad split" aria-labelledby="exp-h" data-spy="experience">
    <div class="split-head"><h2 id="exp-h" class="title" data-reveal>{t.experience}</h2></div>
    <ol class="timeline" data-timeline>
      {timeline.map((e) => (
        <li data-reveal>
          <p class="when">{e.when}</p>
          <h3>{e.title}</h3>
          <p class="org">{e.org}</p>
          <ul class="dots">{e.items.map((d) => <li>{d}</li>)}</ul>
          {e.extras && <dl class="facts-list">{e.extras.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>}
          {e.link && <a class="text-link" href={e.link.href}>{e.link.label} <Icon name="arrow" /></a>}
        </li>
      ))}
    </ol>
  </section>

  <section id="skills" class="slab pad split" aria-labelledby="skills-h">
    <div class="split-head"><h2 id="skills-h" class="title" data-reveal>{t.skills}</h2></div>
    <div class="fetch" data-reveal>
      <p class="fetch-cmd" aria-hidden="true"><span class="chevron">❯</span> fastfetch</p>
      <p class="fetch-title" aria-hidden="true">{f.title}</p>
      {f.boxes.map((box) => (
        <section class="fetch-box" aria-label={box.title}>
          <h3 class="fetch-head"><span>{box.title}</span></h3>
          <dl>
            {box.rows.map((r) => (
              <div class={`fetch-row ${r.color}`} style={`--r: ${row++}`}>
                <dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON[r.icon]} /></svg>{r.key}</dt>
                <dd>{r.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
      <p class="fetch-colors" aria-hidden="true">{['#526473', '#cad3f5', '#8bd5ff', '#c6a0f6', '#7aa2f7', '#eed49f', '#8bd5ca', '#ed8796'].map((c, n) => <i style={`background: ${c}; --n: ${n}`}></i>)}</p>
      <form class="term" data-term autocomplete="off">
        <ol class="term-out" aria-live="polite"></ol>
        <p class="term-segments" aria-hidden="true"><span>~/oztozlu.dev</span><span>main</span></p>
        <label class="term-line"><span class="chevron" aria-hidden="true">❯</span><span class="sr">{k.label}</span><input class="term-in" name="cmd" spellcheck="false" autocapitalize="off" enterkeyhint="go" placeholder={k.hint} /></label>
      </form>
      <script type="application/json" id="term-data" set:html={JSON.stringify(termData).replace(/</g, '\\u003c')} />
    </div>
  </section>

  <section id="about" class="slab pad" aria-labelledby="about-h" data-spy="about">
    <h2 id="about-h" class="title" data-reveal>{t.about}</h2>
    <div class="about-top">
      <figure class="about-photo" data-reveal><img src="/assets/portrait.webp" width="880" height="1100" alt={t.portraitAlt} loading="lazy" decoding="async" /></figure>
      <p class="about-lede" data-words>{a.lede}</p>
    </div>
    <ul class="principles">
      {a.principles.map(([title, text, id], i) => (
        <li data-reveal style={`--d: ${i}`}><h3>{title}</h3><p>{text}</p><a class="text-link" href={localePath(locale, `/projects/${id}`)}>{get(id).name} <Icon name="arrow" /></a></li>
      ))}
    </ul>
  </section>

  <section id="contact" class="slab pad contact" aria-labelledby="contact-h" data-aquarium>
    <canvas class="aquarium" aria-hidden="true"></canvas>
    <h2 id="contact-h" class="shout" data-wave>{t.contact}</h2>
    <p data-reveal>{t.contactNote}</p>
    <div class="mailrow" data-reveal>
      <a class="mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <button type="button" class="circle" data-copy={EMAIL} data-done={t.copied} aria-label={t.copy}><Icon name="copy" /></button>
      <span class="copied" role="status"></span>
    </div>
    <div class="actions" data-reveal>
      <a class="btn btn-2" href={LINKEDIN} target="_blank" rel="noreferrer"><span>LinkedIn</span> <Icon name="out" /></a>
      <a class="btn btn-2" href={GITHUB} target="_blank" rel="noreferrer"><span>GitHub</span> <Icon name="out" /></a>
      <a class="btn btn-2" href={localePath(locale, '/cv')} data-cv-link><span>{t.viewCv}</span></a>
    </div>
    <p class="feed-hint">{t.feedHint}</p>
  </section>
</Base>
