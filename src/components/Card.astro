---
import Icon from './Icon.astro';
import Mochi from './Mochi.astro';
import { localePath, ui, type Locale } from '../data';
import { repoUrl, srcsetOf, type Project } from '../lib/projects';

/* A project card. The whole card leads to the case study when there is one, otherwise to the repository; the live
   site and the code stay one click away as their own links. Its image carries a transition name, so it grows into the
   cover of the project page. */
interface Props { p: Project; locale: Locale; kicker?: string; stack?: string[]; point?: string; small?: boolean; wide?: boolean }
const { p, locale, kicker, stack, point, small = false, wide = false } = Astro.props;
const t = ui[locale];
const page = p.case ? localePath(locale, `/projects/${p.id}`) : undefined;
const code = repoUrl(p);
const img = p.img ?? p.hero;
// A phone shows a card about 330px wide, so it loads a smaller copy where there is one.
const srcset = img && srcsetOf(img);
const sizes = small ? '(max-width: 760px) 85vw, 30vw' : '(max-width: 760px) 85vw, (max-width: 1100px) 90vw, 50vw';
---
<article class:list={['card', { small, wide }]}>
  <div class="card-media" transition:name={`media-${p.id}`}>
    {img
      ? <img src={img.src} srcset={srcset} sizes={srcset && sizes} width={img.w} height={img.h} alt="" loading="lazy" decoding="async" style={p.pos ? `object-position: ${p.pos}` : undefined} />
      : <div class="card-pet"><Mochi label={t.mochi} big /></div>}
  </div>
  <div class="card-body">
    <p class="kicker">{kicker ?? p.lang}</p>
    <h3>{page ? <a class="card-link" href={page}>{p.name}</a> : <a class="card-link" href={code} target="_blank" rel="noreferrer">{p.name}</a>}</h3>
    <p class="card-desc">{p.desc}</p>
    {point && <p class="card-point">{point}</p>}
    {stack && <ul class="chips" aria-label={t.stack}>{stack.map((s) => <li>{s}</li>)}</ul>}
    <div class="card-links">
      {page && <span class="more">{t.caseStudy} <Icon name="arrow" /></span>}
      {p.home && <a href={p.home} target="_blank" rel="noreferrer">{t.live} <Icon name="out" /></a>}
      {code && <a href={code} target="_blank" rel="noreferrer">{t.code} <Icon name="out" /></a>}
    </div>
  </div>
</article>
