{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/fetch-github.ts && astro dev",
    "build": "node scripts/fetch-github.ts && astro build && node scripts/postbuild.ts",
    "preview": "wrangler dev --port 4321",
    "check": "wrangler types >/dev/null && astro check",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "astro": "^7.4.7",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.18.0"
}
