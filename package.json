{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local astro dev",
    "build": "astro build",
    "build:local": "CLOUDFLARE_ENV=local astro build",
    "preview": "astro preview",
    "check": "wrangler types >/dev/null && astro check",
    "test": "node --test \"src/**/*.test.ts\" \"seed/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply folio-local --local --env local",
    "db:migrate:preview": "wrangler d1 migrations apply folio-preview --remote --config wrangler.preview-migrations.jsonc",
    "db:seed:local": "node scripts/seed.ts local",
    "db:seed:preview": "node scripts/seed.ts preview",
    "preview:cloudflare": "astro build && wrangler preview"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/react": "^7.1.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "astro": "^7.4.5",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.61.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
